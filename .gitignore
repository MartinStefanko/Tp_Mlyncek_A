# Test fixtures (input PDFs) and baseline run outputs – only metrics.json is versioned
tests/fixtures/
baseline/*
!baseline/metrics.json
# Further baseline runs (tools/baseline.py --out baseline_v2, baseline_v3, baseline_argon, ...):
# same rule as baseline/. The recording (llm_calls.jsonl, segments.json, outputs, reports/)
# contains document text and stays local.
/baseline_*/*
!/baseline_*/metrics.json

# Versioned JSON: contract schemas and test fixtures (override *.json above)
!schemas/*.json
!tests/contract/fixtures/*.json
!service/mock/fixtures/*.json
