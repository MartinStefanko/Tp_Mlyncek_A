# Copy to .env and fill in. Never commit .env.
# All variables are defined in qgen/config.py (Príloha D). Values below are the defaults.

# --- LLM ------------------------------------------------------------------
# gemini | openai_compatible | anthropic. Checked at start: a missing key / base_url of the
# chosen provider, or a "gemini-..." model with another provider, stops the start.
QGEN_LLM_PROVIDER=gemini
# gemini (LLM and/or embeddings).
GEMINI_API_KEY=
# anthropic (LLM only; Anthropic has no embeddings).
ANTHROPIC_API_KEY=
# openai_compatible: OpenAI, Mistral, Groq, OpenRouter, Ollama, vLLM, LM Studio.
# Base URL incl. /v1, e.g. https://api.openai.com/v1 or http://gpu-server:8001/v1.
QGEN_LLM_BASE_URL=
# Key of the openai_compatible LLM server; may stay empty for a local server.
QGEN_LLM_API_KEY=
# Models. QGEN_LLM_MODEL is the default; _LO and _QUESTIONS are optional and inherit it.
# The gemini-2.5 models of the old baseline return 404 to new users; the reference
# recording on these models will be baseline_v3. A model change needs a new baseline
# (tools/baseline.py).
#   QGEN_LLM_MODEL            checks: topic extraction, LO faithfulness, question faithfulness/answerability
#   QGEN_LLM_MODEL_LO         language detection (LO pipeline), LO generation, prerequisites
#   QGEN_LLM_MODEL_QUESTIONS  language detection (question pipeline), question generation
#   QGEN_LLM_MODEL_EVAL       question quality score
QGEN_LLM_MODEL=gemini-3.1-flash-lite
#QGEN_LLM_MODEL_LO=
#QGEN_LLM_MODEL_QUESTIONS=
# The question quality score uses a stronger model; this is also the code default.
# With another provider set it to that provider's model, or leave it empty to inherit
# QGEN_LLM_MODEL (a gemini-* model with another provider stops the start).
QGEN_LLM_MODEL_EVAL=gemini-3.5-flash
# Anthropic only: max_tokens of one call (the Messages API requires it).
QGEN_LLM_MAX_TOKENS=8192
# Parallel LLM calls of one worker (total = QGEN_WORKERS x this).
QGEN_LLM_MAX_CONCURRENCY=4
# Attempts of one LLM / embedding call (incl. the first). Retried: HTTP 429, 408, 5xx,
# timeout, network errors. HTTP 400/401/403/404 fail at once (job failed, llm_error).
QGEN_LLM_RETRIES=5
# Wait between attempts (s); on HTTP 429 without Retry-After: this x 2^(attempt-1).
QGEN_LLM_RETRY_DELAY_S=3.0
# Client timeout of one LLM / embedding call (s).
QGEN_LLM_TIMEOUT_S=120

# --- Replay (development only) ----------------------------------------------
# QGEN_LLM_PROVIDER=replay / QGEN_EMBED_PROVIDER=replay answer from a recording instead of an
# API (docker-compose.replay.yml, tools/resilience_check.py). NEVER in production: the worker
# logs a loud warning and /v1/info shows "replay": true.
#QGEN_LLM_REPLAY_PATH=baseline_v3/llm_calls.jsonl
# Sleep before every replayed call (s).
QGEN_LLM_REPLAY_DELAY_S=0
# true = question generation fails (job failed, llm_error), to test retry.
QGEN_LLM_REPLAY_FAIL=false

# --- Embeddings -------------------------------------------------------------
# gemini | openai_compatible; independent of QGEN_LLM_PROVIDER (e.g. vLLM + Gemini embeddings).
QGEN_EMBED_PROVIDER=gemini
# openai_compatible only, incl. /v1.
QGEN_EMBED_BASE_URL=
# Key of the openai_compatible embedding server; empty = QGEN_LLM_API_KEY is used.
# Set it when LLM and embeddings run on different servers (e.g. local vLLM + OpenAI embeddings).
QGEN_EMBED_API_KEY=
# Thresholds below are calibrated for gemini-embedding-001; another model needs a new calibration.
QGEN_EMBED_MODEL=gemini-embedding-001
# Texts per embedding call.
QGEN_EMBED_MAX_BATCH=100

# --- Pipeline thresholds (calibrated for the embedding model) -----------------
QGEN_CLUSTER_SIM_THRESHOLD=0.82
QGEN_CLUSTER_REQUIRE_SOURCE_OVERLAP=false
QGEN_TOPIC_MATCH_THRESHOLD=0.72
# Filters (scores 1-5).
QGEN_LO_MIN_FAITHFULNESS_SCORE=3
QGEN_QUESTION_MIN_SCORE=3
QGEN_QUESTION_MIN_FAITHFULNESS_SCORE=3
QGEN_QUESTION_MIN_ANSWERABILITY_SCORE=3
# Report flags only ("faithful" / "answerable"); no effect on the filter.
QGEN_QUESTION_FAITHFUL_SCORE=4
QGEN_QUESTION_ANSWERABLE_SCORE=4

# --- Pipeline batches, attempts, text limits ----------------------------------
QGEN_LO_BATCH_SIZE=10
QGEN_QUESTION_BATCH_SIZE=10
QGEN_QUESTION_EVAL_BATCH_SIZE=20
QGEN_QUESTION_GENERATION_ATTEMPTS=3
QGEN_QUESTION_EVAL_ATTEMPTS=2
QGEN_CHECK_BATCH_ATTEMPTS=2
QGEN_CONTEXT_MAX_CHARS=8000
QGEN_LANGUAGE_SAMPLE_MAX_CHARS=12000
QGEN_TOPIC_SOURCE_MAX_CHARS=20000

# --- Option defaults ------------------------------------------------------
QGEN_DEFAULT_LESSON_MINUTES=45
# OCR of images in the PDF; needs easyocr in the image.
QGEN_OCR_ENABLED=false

# --- Access ---------------------------------------------------------------
# Comma-separated API keys (header X-API-Key). Empty = no check (local only).
QGEN_API_KEYS=

# --- Limits ---------------------------------------------------------------
QGEN_MAX_FILES=10
QGEN_MAX_UPLOAD_MB=50
QGEN_MAX_PAGES=300
QGEN_MAX_ACTIVE_JOBS=10

# --- Retention ------------------------------------------------------------
# Job directories /data/jobs/{id}/ (job.json, input/, result.json, report.json)
QGEN_DATA_DIR=/data
QGEN_RESULT_TTL_DAYS=7
QGEN_FAILED_INPUT_TTL_HOURS=24

# --- Queue ----------------------------------------------------------------
# Redis: job queue, progress cache and external_ref reservations (job.json stays the source of truth).
QGEN_REDIS_URL=redis://redis:6379/0
# Time limit of one job run (s). The job fails with internal_error when it runs longer;
# RQ kills the run 120 s later as a last resort. eko.pdf takes about 290 s.
QGEN_JOB_TIMEOUT_S=3600
# Worker maintenance (PDF / TTL cleanup, recovery of lost jobs) every N s. Shorter only for
# development (docker-compose.replay.yml: 15).
QGEN_MAINTENANCE_INTERVAL_S=600

# --- Webhooks -------------------------------------------------------------
# Hosts allowed in callback_url, comma-separated (host or host:port).
# Empty = webhooks off; a job with callback_url is rejected (400 invalid_options).
QGEN_WEBHOOK_ALLOWED_HOSTS=
# Checked when a job is created and again by the webhook worker before every attempt.
# Local test with tools/webhook_receiver.py: host.docker.internal (README, "Webhooky").
# Shared secret for X-QGen-Signature; Laravel has the same value.
QGEN_WEBHOOK_SECRET=
QGEN_WEBHOOK_TIMEOUT_S=5

# --- Deployment (docker compose) ----------------------------------------------
QGEN_WORKERS=1
# Model of the llm container (profile local-llm).
QGEN_LOCAL_MODEL=

# --- API backend ----------------------------------------------------------
# mock = simulated jobs (Dockerfile.mock); real = job.json in QGEN_DATA_DIR + Redis.
QGEN_BACKEND=mock

# --- Mock only ------------------------------------------------------------
# Simulated duration of one job in seconds ("mock-slow-" jobs take 5x longer).
QGEN_MOCK_DURATION_S=30
