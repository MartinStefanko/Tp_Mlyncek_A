{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qgen/schemas/report.schema.json",
  "description": "Report (GET /v1/jobs/{id}/report)",
  "$defs": {
    "Quality": {
      "additionalProperties": false,
      "description": "Averages in the range 0–1, or null when not measured.\n\nThe pipeline scores on a 1–5 scale; the service converts a score x as (x − 1) / 4.\nTopic coverage is a percentage in the pipeline; the service divides it by 100.",
      "properties": {
        "section_faithfulness_avg": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Faithfulness Avg"
        },
        "question_faithfulness_avg": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Faithfulness Avg"
        },
        "answerability_avg": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answerability Avg"
        },
        "topic_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Coverage"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "QuestionMeta": {
      "additionalProperties": false,
      "description": "Metadata of one question; the question is units[unit].questions[question].",
      "properties": {
        "unit": {
          "description": "Index in units.",
          "minimum": 0,
          "title": "Unit",
          "type": "integer"
        },
        "question": {
          "description": "Index in units[unit].questions.",
          "minimum": 0,
          "title": "Question",
          "type": "integer"
        },
        "section_id": {
          "description": "Section id, e.g. 'S-12'.",
          "pattern": "^S-\\d+$",
          "title": "Section Id",
          "type": "string"
        },
        "bloom_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "title": "Bloom Level",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "source": {
          "description": "Cited files and pages; a question can cite more PDFs.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source",
          "type": "array"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        }
      },
      "required": [
        "unit",
        "question",
        "section_id",
        "bloom_level",
        "keywords",
        "source"
      ],
      "title": "QuestionMeta",
      "type": "object"
    },
    "ReportWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Machine-readable code, e.g. 'field_too_long'.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ReportWarning",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "description": "Section (tematický celok) of the document.",
      "properties": {
        "id": {
          "description": "Section id, e.g. 'S-12'.",
          "pattern": "^S-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "lo_type": {
          "description": "Kind of section, e.g. 'definition'.",
          "title": "Lo Type",
          "type": "string"
        },
        "prerequisites": {
          "description": "Ids of sections this one builds on.",
          "items": {
            "description": "Section id, e.g. 'S-12'.",
            "pattern": "^S-\\d+$",
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "lo_type",
        "prerequisites"
      ],
      "title": "Section",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Source file name, e.g. 'eko.pdf'.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "pages": {
          "description": "Cited pages (1-based).",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "file",
        "pages"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "question_meta": {
      "items": {
        "$ref": "#/$defs/QuestionMeta"
      },
      "title": "Question Meta",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ReportWarning"
      },
      "title": "Warnings",
      "type": "array"
    },
    "timings": {
      "additionalProperties": {
        "minimum": 0.0,
        "type": "number"
      },
      "description": "Seconds per step, e.g. {'extract': 1.5, 'learning_objects': 56.3}.",
      "title": "Timings",
      "type": "object"
    }
  },
  "required": [
    "sections",
    "question_meta",
    "quality",
    "warnings",
    "timings"
  ],
  "title": "Report",
  "type": "object"
}
